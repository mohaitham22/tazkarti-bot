# Copy this file to ".env" (same folder) and fill in your real values.
# Never share your .env file or paste its contents anywhere -- it holds
# your Telegram bot token.

TZK_URL=https://www.tazkarti.com/#/matches
TELEGRAM_BOT_TOKEN=your-new-bot-token-here
TELEGRAM_CHAT_ID=your-real-chat-id-here

# NOTE: there is no prefill helper any more, and no TZK_USERNAME /
# TZK_PASSWORD / TZK_MATCH_URL / TZK_PROFILE_DIR. It was removed
# 2026-08-26 -- see CLAUDE.md. Nothing in this repo needs your Tazkarti
# account credentials, which is deliberate: this repo is PUBLIC, and a
# .env holding them was once committed to it.
#
# Log in to Tazkarti in your ordinary browser and let it remember you.
# That is simpler and more reliable than anything this repo could script.
