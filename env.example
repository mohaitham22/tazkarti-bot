# Copy this file to ".env" (same folder) and fill in your real values.
# Never share your .env file or paste its contents anywhere -- it holds
# your bot token and Tazkarti login.

TZK_URL=https://www.tazkarti.com/#/matches
TELEGRAM_BOT_TOKEN=your-new-bot-token-here
TELEGRAM_CHAT_ID=your-real-chat-id-here

# ---- Prefill helper (alahly_ticket_prefill.py) -- LOCAL ONLY ----
# NEVER add these to GitHub Actions secrets: this repo is public, and the
# helper needs a human at the browser anyway.
#
# TZK_USERNAME is your TAZKARTI ID -- a 14-16 digit number, NOT an email
# and not a username. The login field is labelled "Tazkarti ID" and its
# placeholder is 12345678901234.
#
# Both are only read when you are actually logged out. Once you have
# signed in once, the browser profile remembers the session and the
# helper never touches them.
TZK_USERNAME=your-14-to-16-digit-tazkarti-id
TZK_PASSWORD=your-tazkarti-password

# Where the helper sends you once it knows you are logged in.
# Defaults to the listing below if unset.
TZK_MATCH_URL=https://www.tazkarti.com/#/matches

# Optional: where the helper keeps its persistent browser profile.
# Default is %LOCALAPPDATA%\tazkarti-monitor\browser-profile -- keep it
# out of the repo and out of OneDrive.
#TZK_PROFILE_DIR=
